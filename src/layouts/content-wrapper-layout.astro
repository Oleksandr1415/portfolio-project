---
import Particles from '@/components/ui/particles';
---

<!-- <div class="relative bg-black"> -->
<div
  class="relative min-h-screen w-screen bg-[#050508] bg-[radial-gradient(ellipse_1000px_600px_at_15%_12%,rgba(139,92,246,0.22),transparent_65%),radial-gradient(ellipse_800px_700px_at_85%_18%,rgba(59,130,246,0.16),transparent_60%),radial-gradient(ellipse_1100px_800px_at_30%_55%,rgba(139,92,246,0.18),transparent_65%),linear-gradient(to_bottom,#000000_0%,#060609_30%,#0a0912_55%,#0d0a18_100%)] bg-size-[100%_100%] bg-no-repeat"
>
  <div data-slot="page-content" class="mx-auto w-full max-w-300 px-4 md:px-10">
    <slot />
  </div>
  <div class="absolute top-0 left-0 z-0 h-full w-screen">
    <Particles
      client:load
      particleColors={['#ffffff']}
      particleCount={5000}
      particleSpread={20}
      speed={0.05}
      particleBaseSize={100}
      moveParticlesOnHover={false}
      alphaParticles
      disableRotation={false}
      pixelRatio={1}
    />
  </div>
</div>
