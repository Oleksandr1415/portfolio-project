---
interface Props {
  class: string;
  fill: string;
  stroke: string;
  strokeWidth: number;
  style: object;
}

const {
  class: className,
  stroke = 'white',
  fill = 'white',
  strokeWidth = '1px',
  style = {},
} = Astro.props;
---

<svg class={className} style={style} viewBox="0 0 16 16">
  <path
    stroke={stroke}
    fill={fill}
    stroke-width={strokeWidth}
    d="
      M 1,3
      C 17,5
        -1,7
        13,7
    "></path>
</svg>
