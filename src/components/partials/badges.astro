---
interface Badge {
  text: string;
}
interface Props {
  class?: string;
  badgeClass?: string;
  badgeList: Badge[];
  variant?: 'gray' | 'science' | 'experience' | 'after';
}
const { class: className, badgeClass, badgeList = [], variant } = Astro.props;

const variants = {
  gray: {
    container: '',
    badge: 'rounded-[10000px] border border-white/15 bg-white/7 text-white/80 text-base uppercase',
  },
  science: {
    container: '',
    badge: '',
  },
  experience: {
    container: '',
    badge: '',
  },
  after: {
    container: '',
    badge: '',
  },
};

const selectedVariant = variant ? variants[variant] : variants['gray'];
---

<div data-slot="badges-container" class:list={['flex gap-2', selectedVariant.container, className]}>
  {
    badgeList.map((badge) => (
      <span
        data-slot="badge"
        class:list={[
          'flex items-center justify-center px-3 py-1',
          selectedVariant.badge,
          badgeClass,
        ]}
      >
        {badge.text}
      </span>
    ))
  }
</div>
