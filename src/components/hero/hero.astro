---
import Picture from 'astro/components/Picture.astro';
import heroBg from '@/assets/heroBg.jpg';

import { Dot } from '@lucide/astro';
import Button from '@/partials/button/button';
import TextWriter from '@/components/ui/text-writer';
// import Lightfall from '@/components/ui/lightfall';

const heroHeadlineTexts: string[] = ['Sasha', 'Frontend-Developer'];
---

<section
  data-slot="Hero"
  id="hero"
  class="relative flex h-screen w-full flex-col items-center justify-center"
>
  <!-- <div class="absolute size-full">
    <Lightfall
      client:load
      colors={['#A6C8FF', '#5227FF', '#FF9FFC']}
      backgroundColor="#026684"
      speed={0.3}
      streakCount={3}
      streakWidth={1}
      streakLength={0.4}
      glow={0.7}
      density={0.6}
      twinkle={1}
      zoom={1}
      backgroundGlow={0.2}
      opacity={1}
      mouseInteraction
      mouseStrength={0}
      mouseRadius={0.4}
    />
  </div> -->

  <!-- bg-image -->
  <Picture
    src={heroBg}
    alt=""
    formats={['avif', 'webp']}
    widths={[640, 1280, 1920]}
    sizes="100vw"
    class="absolute inset-0 -z-10 h-full w-full bg-black bg-linear-to-b from-transparent from-50% to-black object-cover"
  />

  <!-- Shadow in the bottom of bg-image -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-linear-to-b from-transparent from-30% to-black"
  >
  </div>

  <span class="text-text-gray-white mx-auto pt-14 pl-2 tracking-[8px] uppercase backdrop-blur-[1px]"
    >Hello</span
  >
  <div data-slot="text" class="flex justify-center p-2 backdrop-blur-[1px]">
    <span
      class="font-heading h-auto text-center text-6xl font-black text-white select-none md:h-auto md:text-8xl"
      >I am
      <TextWriter
        className="bg-gradient-hero font-heading inline w-full overflow-hidden bg-clip-text font-black text-transparent"
        client:load
        cursorClassName="bg-clip-text text-transparent bg-gradient-hero"
        deleteSpeed={100}
        pauseTime={1000}
        texts={heroHeadlineTexts}
        typeSpeed={200}
      />
    </span>
  </div>

  <span class="text-text-gray-light"
    >fast & curious<Dot class="inline size-6" />communicative
  </span>

  <Button href="#contact" className="z-1 mt-10 text-xl">
    Let's talk
    <span class="text-base transition-transform duration-300 group-hover:translate-x-1"> → </span>
  </Button>

  <span class="text-text-gray-light block pt-30 md:pt-20">Want to know more?</span>
  <div
    class="flex w-full items-center justify-center gap-5 p-5 text-sm text-white backdrop-blur-[1px]"
  >
    <Button href="#about" variant="outline">
      <span class="text-inherit">About</span>
    </Button>

    <Button href="#skills" variant="outline">
      <span class="text-inherit">Skills</span>
    </Button>
  </div>
</section>
