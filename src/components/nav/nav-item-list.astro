---
import { menuElements } from '@/mock/nav-menu-elements';
import { getHomeHashLink, getLangFromUrl, resolvePath, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const baseClass = ['relative inline-block transition-all duration-300 hover-text-underline'];

const { class: className, dataSlot = 'menu' } = Astro.props;

function resolveMenuHref(href: string) {
  return href.startsWith('#') ? getHomeHashLink(lang, href) : href;
}
---

<ul data-slot={dataSlot} aria-label="Main navigation" class:list={['text-md gap-4 py-2 font-bold text-white', className]}>
  {
    menuElements.map((menuLink) => {
      return (
        <li class="flex h-full items-center">
          <a
            href={resolveMenuHref(menuLink.href)}
            data-slot="menu-item"
            class:list={[baseClass, menuLink.linkClass]}
          >
            {resolvePath(t, menuLink.i18nKey)}
          </a>
        </li>
      );
    })
  }
</ul>
