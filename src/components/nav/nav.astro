---
import { Menu, X } from '@lucide/astro';
import NavItemList from './nav-item-list.astro';
import { cn } from '@/utils/helpers';
---

<nav
  data-slot="nav"
  class="text-whitev h-nav fixed top-0 right-0 left-0 z-1001 mx-auto w-full max-w-300 rounded-b-md bg-gray-900/40 px-4 text-white backdrop-blur-md md:px-10"
>
  <div data-slot="nav-container" class="relative flex h-full items-center justify-between">
    <a
      href="/"
      data-slot="logo"
      class="font-heading hover-text-underline relative text-2xl font-black tracking-[4px] text-white transition-all duration-300"
    >
      Oleksandr
    </a>
    <button data-slot="nav-menu-toggle" class="relative size-7 md:hidden">
      <Menu
        id="nav-menu-burger-icon"
        class="absolute top-0 z-1001 size-full transition-all duration-300 hover:cursor-pointer"
      />
      <X
        id="nav-menu-close-icon"
        fill="white"
        class="absolute top-0 z-1001 size-full opacity-0 transition-all duration-300 hover:cursor-pointer"
      />
    </button>
    <NavItemList class="hidden h-full md:flex" />

    <div
      data-slot="nav-menu-close-background"
      class={cn([
        'fixed top-0 left-0 h-screen w-screen z-50 bg-gray-900/50 transition-all duration-600 ease-in md:hidden',
        '-translate-y-full cursor-[url("/x.svg"),pointer]',
      ])}
    >
    </div>
    <div
      id="nav-menu-background-planet"
      class={cn([
        'bg-gradient-nav-menu flex size-[220vh] flex-col items-center justify-end rounded-[60%] md:hidden',
        'absolute top-0 left-[50%] z-1000 -translate-x-1/2 -translate-y-full',
        'duration-800 ease-out',
      ])}
    >
      <NavItemList
        dataSlot="nav-menu"
        class="z-1001 flex flex-col items-center gap-10 pb-30 text-xl text-white md:hidden"
      />
    </div>
  </div>
</nav>

<script>
  import '@/scripts/nav/menu.js';
</script>
