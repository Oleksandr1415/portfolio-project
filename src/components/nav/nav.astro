---
import { Menu, X } from '@lucide/astro';
import NavItemList from './nav-item-list.astro';
import NavLanguageSelector from './nav-language-selector.astro';
import { cn } from '@/utils/helpers';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<nav
  data-slot="nav"
  class="text-whitev h-nav fixed top-0 right-0 left-0 z-1001 mx-auto w-full max-w-300 rounded-b-md bg-gray-900/40 px-4 text-white backdrop-blur-md md:px-10"
>
  <div data-slot="nav-container" class="relative flex h-full items-center justify-between">
    <a
      href={`/${lang}/`}
      data-slot="logo"
      class="font-heading hover-text-underline focus-ring-nav relative rounded-sm text-2xl font-black tracking-[4px] text-white transition-all duration-300"
    >
      {t.nav.logo}
    </a>

    <button
      type="button"
      data-slot="nav-menu-toggle"
      class="focus-ring-nav relative z-1001 size-7 rounded-sm md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-menu-background-planet"
    >
      <Menu
        id="nav-menu-burger-icon"
        aria-hidden="true"
        class="pointer-events-none absolute top-0 size-full transition-opacity duration-300"
      />
      <X
        id="nav-menu-close-icon"
        aria-hidden="true"
        fill="white"
        class="pointer-events-none absolute top-0 size-full opacity-0 transition-all duration-300"
      />
    </button>

    <div class="hidden h-full items-center gap-6 md:flex">
      <NavLanguageSelector />
      <NavItemList class="flex h-full" />
    </div>

    <!-- ------------ Mobile - Menu ------------ -->
    <!-- close-menu background -->
    <button
      type="button"
      data-slot="nav-menu-close-background"
      aria-label="Close menu"
      tabindex="-1"
      inert
      class={cn([
        'fixed top-0 left-0 h-screen w-screen z-50 border-0 bg-gray-900/50 p-0 transition-all duration-600 ease-in md:hidden',
        '-translate-y-full cursor-[url("/x.svg"),pointer]',
      ])}
    >
    </button>
    <!-- menu inhalt -->
    <div
      id="nav-menu-background-planet"
      inert
      aria-hidden="true"
      class={cn([
        'bg-gradient-nav-menu flex size-[220vh] flex-col items-center justify-end rounded-[60%] md:hidden',
        'absolute top-0 left-[50%] z-1000 -translate-x-1/2 -translate-y-full',
        'duration-800 ease-out',
      ])}
    >
      <NavLanguageSelector variant="mobile" class="z-1001 pb-30 md:hidden" />
      <NavItemList
        dataSlot="nav-menu"
        class="z-1001 flex flex-col items-center gap-10 pb-10 text-xl text-white md:hidden"
      />
    </div>
  </div>
</nav>

<script>
  import '@/scripts/nav/menu.js';
</script>
