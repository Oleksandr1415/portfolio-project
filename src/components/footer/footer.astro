<footer
  data-slot="footer-container"
  class="relative flex w-screen flex-col items-center justify-center border-t border-t-white/20 bg-black px-4 py-10 text-white"
>
  <div class="absolute inset-0 top-0 bottom-0 left-0 z-1 w-full bg-white/5"></div>

  <!-- Main footer -->
  <div class="relative z-2 flex flex-col items-center">
    <!-- Identity -->
    <span class="text-center text-white/25">
      2026 OLEKSANDR · Crafted with code & curiosity · Dorsten
    </span>

    <!-- Separator -->
    <div class="my-4 h-px w-40 bg-white/15"></div>

    <!-- Social links -->
    <div data-slot="contact" class="flex items-center justify-center">
      <div data-slot="links-container" class="flex h-10 items-center justify-center gap-4 p-2">
        <a
          href="https://www.linkedin.com/in/oleksandr-pustovit-4915b7190"
          data-slot="icon1"
          class="size-6 rounded-md transition-transform hover:-translate-y-0.5 hover:shadow-[0_2px_3px_rgba(255,255,255,0.8)]"
        >
          <LinkedIn class="fill-text-gray-light stroke-text-gray-light size-6" />
        </a>

        <a
          href="#"
          data-slot="icon2"
          class="size-6 rounded-md transition-transform hover:-translate-y-0.5 hover:shadow-[0_2px_3px_rgba(255,255,255,0.8)]"
        >
          <TwitterIcon outline class="fill-text-gray-light stroke-text-gray-light size-full" />
        </a>

        <a
          href="https://github.com/Oleksandr1415"
          data-slot="icon3"
          class="size-6 rounded-md transition-transform hover:-translate-y-0.5 hover:shadow-[0_2px_3px_rgba(255,255,255,0.8)]"
        >
          <GithubIcon class="fill-text-gray-light stroke-text-gray-light size-6" /></a
        >
      </div>
    </div>

    <!-- Separator -->
    <div class="my-4 h-px w-40 bg-white/15"></div>

    <!-- Legal links -->
    <div class="mt-2 flex items-center gap-2 text-xs text-white/30">
      <a href="/impressum" class="transition-colors hover:text-white/70"> Impressum </a>

      <span aria-hidden="true" class="text-white/20">·</span>

      <a href="/datenschutz" class="transition-colors hover:text-white/70"> Datenschutz </a>
    </div>
  </div>
</footer>
