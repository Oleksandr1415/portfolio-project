---
import { menuElements } from '@/mock/navMenuElements';
const baseClass =
  'on-hover-text-yellow h-full flex items-center text-nowrap hover:shadow-[0_2px_3px_0_rgba(255,255,255,0.3)]';

const { class: className, dataSlot = 'menu' } = Astro.props;
---

<ul data-slot={dataSlot} class:list={['text-md gap-4 py-2 font-bold text-white', className]}>
  {
    menuElements.map((menuLink) => (
      <li class="h-full">
        <a href={menuLink.href} data-slot="menu-item" class:list={[baseClass, menuLink.linkClass]}>
          {menuLink.title}
        </a>
      </li>
    ))
  }
</ul>
