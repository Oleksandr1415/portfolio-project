---
import HeadlineBlock from './partials/headlineBlock.tsx';
import { Mail, Send } from '@lucide/astro';
---

<section id="contact" data-slot="ending-cta" class="pt-25">
  <div data-slot="footer-container" class="relative flex flex-col items-center justify-center">
    <HeadlineBlock
      subHeadline="Contact"
      headlineVariant="h2"
      headlineClass="text-white"
      postHeadline="Something Great"
      postHeadlineClass="bg-gradient-text pt-2 text-transparent text-5xl"
    >
      Let's Build
    </HeadlineBlock>

    <p class="pt-7 text-center text-base text-white/42">
      For the last several months I've <span class="text-primary-soft/60 text-gradient"
        >returned</span
      > my skills (React, TS, html, css) and <span class="text-gradient">learned</span> a lot of new (Astro,
      Next.js, package managers, CMS, svgs...). Can develop, can refactor, can discuss.
    </p>
    <p class="text-center text-lg text-white/42">Lets Talk!</p>

    <a
      href="mailto:pusamy19982@gmail.com"
      class="group bg-gradient-hero hover:bg-gradient-hero-hover mt-8 mb-40 flex max-w-40 items-center justify-center rounded-[9999px] p-4 text-white no-underline duration-300 hover:translate-x-0.5 hover:-translate-y-0.5"
    >
      <div class="relative size-5">
        <Mail
          class="group-hover:scale-0.5 absolute top-0 left-0 size-5 opacity-100 transition-all duration-300 group-hover:opacity-0"
        />
        <Send
          class="scale-0.5 absolute top-0 left-0 size-5 opacity-0 transition-all duration-300 group-hover:scale-100 group-hover:opacity-100"
        />
      </div>
      <span
        class="pl-2 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        >Say Hello !</span
      >
    </a>
  </div>
</section>
