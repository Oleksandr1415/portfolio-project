---
import HeadlineBlock from '@/partials/headline/headline-block.tsx';
import CtaContact from './cta-contact';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" data-slot="ending-cta" class="mx-auto max-w-125 pt-25">
  <div data-slot="footer-container" class="relative flex flex-col items-center justify-center">
    <HeadlineBlock
      subHeadline={t.nav.contact}
      headlineVariant="h2"
      headlineClass="text-white"
      postHeadline={t.cta.postHeadline}
      postHeadlineClass="bg-gradient-text py-2 text-transparent text-5xl"
    >
      {t.cta.headline}
    </HeadlineBlock>

    <p class="pt-7 text-center text-base text-white/42">
      For the last several months I've <span class="text-primary-soft/60 text-gradient"
        >returned</span
      > my skills (React, TS, html, css) and <span class="text-gradient">learned</span> a lot of new (Astro,
      Next.js, package managers, CMS, svgs...). Can develop, can refactor, can discuss.
    </p>
    <p class="text-center text-lg text-white/42">Lets Talk!</p>

    <CtaContact client:load />
  </div>
</section>
