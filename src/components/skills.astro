---
import HeadlineBlock from './partials/headlineBlock.tsx';
import { AccordionComponent } from './partials/accordion/accordion';
import Badges from './partials/badges';

const coreSkills = ['JS', 'TS', 'HTML', 'CSS', 'PHP', 'React'];
const mockPlanets = [
  {
    class: '',
    badgesList: ['React', 'Next.js', 'Laravel Blade', 'Angular', '...'],
    description: '5 technologies',
    design: 'framework' as 'framework',
    headline: 'Framework',
  },
  {
    class: '',
    badgesList: ['CSS', 'SCSS/Sass', 'Tailwind', 'Bulma', 'Material UI'],
    description: '5 technologies',
    design: 'markup' as 'markup',
    headline: 'Markup',
  },
  {
    class: '',
    badgesList: ['Figma', 'Miro'],
    description: '2 technologies',
    design: 'design' as 'design',
    headline: 'Design',
  },
  {
    class: '',
    badgesList: ['Git/GitHub', 'Docker (ddev)', 'Vite', 'Vs Code', 'DevTools'],
    description: '6 technologies',
    design: 'tool' as 'tool',
    headline: 'Tools',
  },
];
---

<section id="skills" class="flex flex-col items-center pt-20 text-white">
  <HeadlineBlock
    client:load
    headlineVariant="h2"
    subHeadline="Expertise"
    postHeadline="Tap a category to explore"
  >
    Skills PLanet
  </HeadlineBlock>

  <div data-slot="skills-diagram-mobile"></div>
  <span
    class="pt-8 text-center text-base tracking-[4px] text-white/30 uppercase text-shadow-[-4px_-4px_5px_var(--color-accent)]"
  >
    Core skills
  </span>
  <Badges badgeList={coreSkills} className="pt-3" />
  <div class="cardList flex w-full flex-col items-center gap-2 pt-5">
    <AccordionComponent
      class="w-full"
      accordionItems={mockPlanets}
      multiple={true}
      defaultValue={mockPlanets[0].headline}
      client:load
    />
  </div>
</section>esbenp.prettier-vscode
