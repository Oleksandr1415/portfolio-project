---
import Card from './partials/card.astro';
import HeadlineBlock from './partials/headlineBlock.astro';

const mockCards = [
  {
    class: '',
    description: '5 technologies',
    headline: 'Framework',
    design: 'teal' as 'teal',
  },
  {
    class: '',
    description: '5 technologies',
    headline: 'Markup',
    design: 'red' as 'red',
  },
  {
    class: '',
    description: '2 technologies',
    headline: 'Design',
    design: 'purple' as 'purple',
  },
  {
    class: '',
    description: '6 technologies',
    headline: 'Tools',
    design: 'orange' as 'orange',
  },
];
---

<section id="skills" class="flex flex-col items-center pt-20 text-white">
  <HeadlineBlock
    headlineVariant="h2"
    subHeadline="Expertise"
    postHeadline="Tap a category to explore"
  >
    Skills PLanet
  </HeadlineBlock>

  <div data-slot="skills-diagram-mobile"></div>
  <span class="pt-8 text-center text-xs tracking-[4px] text-white/30 uppercase">Core skills</span>
  <!-- Badgelist here -->
  <div class="cardList flex w-full flex-col gap-2 pt-10">
    {
      mockCards.map((card) => (
        <Card
          class:list={[card.class]}
          headline={card.headline}
          description={card.description}
          design={card.design}
        />
      ))
    }
  </div>
</section>esbenp.prettier-vscode
