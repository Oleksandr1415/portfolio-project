---
import HeadlineBlock from './partials/headlineBlock.tsx';
import { AccordionComponent } from './partials/accordion/accordion';
import Badges from './partials/badges';
import { skillPlanets, coreSkills } from '@/mock/skill-planets';
---

<section id="skills" class="mx-auto flex flex-col items-center pt-20 text-white">
  <HeadlineBlock
    client:load
    headlineVariant="h2"
    subHeadline="Expertise"
    postHeadline="Tap a category to explore"
  >
    Skills PLanet
  </HeadlineBlock>

  <div data-slot="skills-diagram-mobile"></div>
  <span
    class="pt-8 text-center text-base tracking-[4px] text-white/30 uppercase text-shadow-[-4px_-4px_5px_var(--color-accent)]"
  >
    Core skills
  </span>
  <Badges badgeList={coreSkills} className="pt-3" />
  <div class="cardList flex w-full flex-col items-center gap-2 pt-5">
    <AccordionComponent
      client:load
      class="w-full"
      accordionItems={skillPlanets}
      defaultValue={skillPlanets[0].headline}
      multiple={true}
    />
  </div>
</section>esbenp.prettier-vscode
