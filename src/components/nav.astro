---
import { Menu, X } from '@lucide/astro';
import NavItemList from './nav-item-list.astro';
import { cn } from '@/utils/helpers';
---

<nav
  data-slot="nav"
  class="fixed top-0 right-0 left-0 z-1 mx-auto h-15 w-full max-w-300 rounded-b-md bg-gray-500/40 px-6 text-white md:px-8"
>
  <div data-slot="container" class="relative flex h-full items-center justify-between">
    <a
      href="/"
      data-slot="logo"
      class="font-heading from-red-600 via-yellow-500 to-orange-400 bg-clip-text text-2xl font-black tracking-[4px] text-white transition-all duration-300 hover:bg-linear-to-r hover:text-transparent"
    >
      Oleksandr
    </a>
    <button data-slot="toggle-nav-menu" class="relative size-7 md:hidden">
      <Menu
        id="nav-menu-burger-icon"
        class="absolute top-0 z-1001 size-full transition-all duration-300 hover:cursor-pointer"
      />
      <X
        id="nav-menu-close-icon"
        fill="white"
        class="absolute top-0 z-1001 size-full opacity-0 transition-all duration-300 hover:cursor-pointer"
      />
    </button>
    <NavItemList class="hidden h-full md:flex" />

    <div
      data-slot="nav-menu-background"
      class={cn([
        'fixed top-0 left-0 z-50 size-full bg-gray-900/50 transition-all duration-600 ease-in md:hidden',
        '-translate-y-full',
      ])}
    >
    </div>
    <div
      id="navigation-planet"
      class={cn([
        'bg-gradient-nav-menu flex size-[220vh] flex-col items-center justify-end rounded-[60%] bg-red-500 md:hidden',
        'absolute top-0 left-[50%] z-1000 -translate-x-1/2 -translate-y-full',
        'duration-800 ease-out',
      ])}
    >
      <NavItemList
        dataSlot="nav-menu"
        class="z-1001 flex flex-col items-center pb-15 text-white md:hidden"
      />
    </div>
  </div>
</nav>

<script>
  import '../scripts/nav/menu.js';
</script>
