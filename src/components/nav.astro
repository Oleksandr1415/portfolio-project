---
import { Menu, X } from "@lucide/astro";
import NavItemList from "./nav-item-list.astro";
---

<nav
	data-slot="nav"
	class="fixed top-0 left-0 z-1 right-0 h-15 max-w-300 w-full mx-auto px-6 md:px-8 bg-gray-500/40 text-white rounded-b-md"
>
	<div
		data-slot="container"
		class="relative flex justify-between h-full items-center"
	>
		<a
			href="/"
			data-slot="logo"
			class="text-white font-heading text-2xl font-black tracking-[4px] hover:bg-linear-to-r from-red-600 via-yellow-500 to-orange-400 bg-clip-text hover:text-transparent transition-all duration-300"
		>
			Oleksandr
		</a>
		<button data-slot="toggle-nav-menu" class="relative md:hidden size-7">
			<Menu
				id="nav-menu-burger-icon"
				class="absolute top-0 z-1001 size-full transition-all duration-300 hover:cursor-pointer"
			/>
			<X
				id="nav-menu-close-icon"
				fill="white"
				class="absolute top-0 z-1001 opacity-0 size-full transition-all duration-300 hover:cursor-pointer"
			/>
		</button>
		<NavItemList class="h-full hidden md:flex" />

		<div
			data-slot="nav-menu-background"
			class:list={[
				"md:hidden fixed size-full top-0 left-0 bg-gray-900/50 z-50 transition-all duration-600 ease-in",
				"-translate-y-full",
			]}
		>
		</div>
		<div
			id="navigation-planet"
			class:list={[
				"flex md:hidden flex-col items-center rounded-[60%] justify-end size-[220vh] bg-red-500 bg-gradient-nav-menu",
				"absolute z-1000 -translate-x-1/2 top-0 -translate-y-full left-[50%]",
				"duration-800 ease-out",
			]}
		>
			<NavItemList
				dataSlot="nav-menu"
				class="flex flex-col md:hidden items-center z-1001 text-white pb-15"
			/>
		</div>
	</div>
</nav>

<script>
	import "../scripts/nav/menu.js";
</script>
