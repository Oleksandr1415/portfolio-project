---
import SkillsMobileAccordion from './skills-mobile-accordion';
import Badges from '@/partials/badges/badges';

const { coreSkills, skillPlanets } = Astro.props;
---

<div
  data-slot="skills-mobile"
  class="flex w-full max-w-lg flex-col items-center px-2 sm:px-5 lg:hidden"
>
  <span
    class="text-text-gray pt-8 text-base tracking-[4px] uppercase text-shadow-[-4px_-4px_5px_var(--color-accent)]"
  >
    Core skills
  </span>
  <Badges badgeList={coreSkills} className="pt-3" badgeClass="text-text-gray-lighter" />

  <div class="cardList flex w-full flex-col items-center gap-2 pt-5">
    <SkillsMobileAccordion
      client:load
      accordionItems={skillPlanets}
      defaultValue={skillPlanets[0].headline}
      multiple={true}
    />
  </div>
</div>
