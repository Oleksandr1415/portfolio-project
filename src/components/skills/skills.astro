---
import HeadlineBlock from '@/partials/headline/headline-block.tsx';
import { skillPlanets, coreSkills } from '@/mock/skills.ts';
import SkillsMobile from './skills-mobile/index.astro';
import SkillsDesktop from './skills-desktop';
---

<section
  id="skills"
  data-slot="skills-section"
  class="mx-auto flex flex-col items-center pt-20 text-white"
>
  <HeadlineBlock
    client:load
    headlineVariant="h2"
    subHeadline="Expertise"
    postHeadline="Tap a category to explore"
  >
    Skill Planets
  </HeadlineBlock>

  <SkillsMobile skillPlanets={skillPlanets} coreSkills={coreSkills} />

  <SkillsDesktop skillPlanets={skillPlanets} coreSkills={coreSkills} client:load />
</section>
