---
import HeadlineBlock from '../partials/headline-block.tsx';
import { skillPlanets, coreSkills } from '@/mock/skill-planets';
import SkillsMobile from './skills-mobile.astro';
import SkillsDesktop from './skills-desktop';
---

<section id="skills" class="mx-auto flex flex-col items-center pt-20 text-white">
  <HeadlineBlock
    client:load
    headlineVariant="h2"
    subHeadline="Expertise"
    postHeadline="Tap a category to explore"
  >
    Skills PLanet
  </HeadlineBlock>

  <SkillsMobile skillPlanets={skillPlanets} coreSkills={coreSkills} />

  <SkillsDesktop skillPlanets={skillPlanets} coreSkills={coreSkills} client:load />
</section>
