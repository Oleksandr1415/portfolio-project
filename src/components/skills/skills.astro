---
import HeadlineBlock from '../partials/headlineBlock.tsx';
import { skillPlanets, coreSkills } from '@/mock/skill-planets';
import SkillsMobile from './skillsMobile.astro';
import SkillsDesktop from './skillsDesktop.astro';
---

<section id="skills" class="mx-auto flex flex-col items-center pt-20 text-white">
  <HeadlineBlock
    client:load
    headlineVariant="h2"
    subHeadline="Expertise"
    postHeadline="Tap a category to explore"
  >
    Skills PLanet
  </HeadlineBlock>

  <SkillsMobile skillPlanets={skillPlanets} coreSkills={coreSkills} />

  <SkillsDesktop skillPlanets={skillPlanets} coreSkills={coreSkills} />
</section>esbenp.prettier-vscode
