---
import { cn } from '@/utils/helpers';
import RoadmapCard from './roadmap-card.astro';
import { roadmapStops } from '@/mock/roadmap';
const leftStops = roadmapStops.filter((_, index) => index % 2 === 0);
const rightStops = roadmapStops.filter((_, index) => index % 2 === 1);

// SSoT. AFFECTS SVG PLACING. NEVER CHANGE WITHOUT CHANGING SVG PARAMS
const roadmapClasses = {
  ulClass: 'flex flex-col justify-start gap-16 relative z-10 ',
  liClass: 'h-60 max-h-60 max-w-80 w-80 relative z-10',
  roadmapCardClass: 'items-start',
};
---

<div
  data-slot="roadmap-stops-container"
  class="relative hidden w-full justify-between pt-20 md:flex"
>
  <svg
    data-slot="roadmap-connectors"
    class="pointer-events-none absolute inset-0 z-0 size-full overflow-visible"></svg>
  <ul data-slot="roadmap-left-col" class={roadmapClasses.ulClass}>
    {
      leftStops.map((stop) => {
        return (
          <li class={cn(['', roadmapClasses.liClass])}>
            <RoadmapCard stop={stop} class={roadmapClasses.roadmapCardClass} />
          </li>
        );
      })
    }
  </ul>

  <ul data-slot="roadmap-right-col" class={cn([roadmapClasses.ulClass, 'pt-30'])}>
    {
      rightStops.map((stop) => {
        return (
          <li class={cn(['', roadmapClasses.liClass])}>
            <RoadmapCard stop={stop} class={roadmapClasses.roadmapCardClass} />
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  const Y_BOX_HEIGHT = 240; // li: h-60 *4
  const Y_GAP = 64; //ul: gap-16 *4
  const Y_RIGHT_COL_OFFSET = 120; //ul: (second list exclusively) pt-30 *4
  const Y_CONTAINER_OFFSET = 80;

  const X_SECTION_WIDTH = 1000; // section-container: max-w-250 * 4
  const X_BOX_WIDTH = 320; // li: w-80 * 4

  const TOTAL_STOPS = 10; // replace with actual roadmapStops.length, passed via a data attribute if dynamic

  function drawLine() {
    const svg = document.querySelector('[data-slot="roadmap-connectors"]');
    if (!svg) {
      return;
    }
    const x_Left = X_BOX_WIDTH / 2;
    const x_Right = X_SECTION_WIDTH - X_BOX_WIDTH / 2;
    const y_LeftFirst = Y_CONTAINER_OFFSET + 120;
    const y_RightTop = Y_CONTAINER_OFFSET + Y_RIGHT_COL_OFFSET + 30;
    const y_RightFirst = Y_CONTAINER_OFFSET + Y_RIGHT_COL_OFFSET + 120;

    const yInterval = Y_BOX_HEIGHT + Y_GAP;

    // default entrance curve
    let pathsHtml = `<path d="M 400 0 C 400 40, 100 50,  ${x_Left} ${y_LeftFirst}," stroke="#8b5cf6" stroke-width="2" fill="none" />`;

    for (let i = 0; i < TOTAL_STOPS - 1; i++) {
      const right_multiplier = Math.floor(i / 2); // 0 0 1 1 2 2 3 3    --- Right multiplier
      const left_multiplier = Math.floor((i + 1) / 2); // 0 1 1 2 2 3 3  --- left multiplier
      console.log('right:' + right_multiplier + '-------------' + 'left:' + left_multiplier);
      const y_Left = y_LeftFirst + left_multiplier * yInterval;

      if (i % 2 === 0) {
        // ** left to right **

        const y_Right = y_RightTop + right_multiplier * yInterval;
        const c1_X = X_SECTION_WIDTH / 2;
        const c1_Y = 100 + yInterval * left_multiplier;
        const c2_X = X_SECTION_WIDTH;
        const c2_Y = 200 + yInterval * left_multiplier;
        pathsHtml += `<path d="M ${x_Left} ${y_Left} C ${c1_X} ${c1_Y}, ${c2_X} ${c2_Y}, ${x_Right} ${y_Right} "  stroke="#8b5cf6" stroke-width="2" fill="none" />`;
        // pathsHtml += `<path d="M ${x_Right} ${y_Right} C ${c1_X} ${c1_Y}, ${c2_X} ${c2_Y}, ${x_Left} ${y_Left} "  stroke="#8b5cf6" stroke-width="2" fill="none" />`;
      } else {
        // ** right to left **

        const y_Right = y_RightFirst + right_multiplier * yInterval;
        const c1_X = X_SECTION_WIDTH - 100;
        const c1_Y = y_RightFirst + 50 + Y_BOX_HEIGHT + yInterval * right_multiplier;
        const c2_X = 0;
        const c2_Y = Y_BOX_HEIGHT + Y_BOX_HEIGHT * right_multiplier;
        console.log(yInterval * right_multiplier - y_Right);
        pathsHtml += `<path d="M ${x_Right} ${y_Right} C ${c1_X} ${c1_Y}, ${c2_X} ${c2_Y}, ${x_Left} ${y_Left} "  stroke="#8b5cf6" stroke-width="2" fill="none" />`;
        // pathsHtml += `<path d="M ${x_Left} ${y_Left} C ${c1_X} ${c1_Y}, ${c2_X} ${c2_Y}, ${x_Right} ${y_Right} "  stroke="#8b5cf6" stroke-width="2" fill="none" />`;
      }
      pathsHtml += '';
    }

    svg.innerHTML = pathsHtml;
  }

  drawLine();
</script>
