---
import { cn } from '@/utils/helpers';
import HeadlineBlock from '@/partials/headline/headline-block';
import Circle from '@/assets/svgs/circle.svg';
import { roadmapStops, roadmapStopVariants } from '@/mock/roadmap';

const { class: className } = Astro.props;
---

<section
  data-slot="roadmap-stops-container"
  class={cn(['flex flex-col items-stretch pt-10', className])}
>
  {
    roadmapStops.map((stop, index) => {
      const selectedVariant = roadmapStopVariants[stop.variant];
      return (
        <div class="relative flex items-center pl-1">
          <div
            class={cn([
              'from-primary/30 to-primary/30 absolute top-0 bottom-0 left-0 mt-[-5] w-1 bg-linear-to-b py-4',
              selectedVariant.line,
            ])}
          />
          <Circle class="size-5" />
          <div
            data-slot="roadmap-stop-container"
            class={cn([
              'relative mt-3 flex grow flex-col rounded-xl border p-4',
              selectedVariant.container,
            ])}
          >
            <HeadlineBlock
              data-slot="roadmap-stop-headline"
              className="items-start text-white/90"
              headlineClass="pt-1"
              headlineVariant="h3"
              subHeadline={stop.headlineBlock?.subHeadline}
              subHeadlineClass={cn([selectedVariant.subHeadlineClass])}
              postHeadline={stop.headlineBlock?.postHeadline}
              postHeadlineClass={cn([
                'text-[10px] text-start pt-0 tracking-[0.5px]',
                selectedVariant.postHeadlineClass,
              ])}
            >
              {stop.headlineBlock?.headline}
            </HeadlineBlock>
            <p data-slot="roadmap-stop-description" class="text-xs font-light text-white/45">
              {stop.description}
            </p>
          </div>
        </div>
      );
    })
  }
</section>
