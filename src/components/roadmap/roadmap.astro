---
import HeadlineBlock from '../partials/headlineBlock.tsx';
import RoadmapMobile from './roadmap-mobile.astro';
import RoadmapDesktop from './roadmapDesktop.astro';
---

<section
  id="roadmap"
  data-slot="roadmap-container"
  class="md: mx-auto flex max-w-125 flex-col items-center pt-30 md:max-w-230"
>
  <HeadlineBlock
    data-slot="roadmap-header"
    className="text-white"
    headlineVariant="h2"
    postHeadline="every opportunity on my way to where I am"
    subHeadline="journey"
  >
    Life Roadmap
  </HeadlineBlock>

  <RoadmapMobile class="md:hidden" />
  <RoadmapDesktop class="hidden lg:flex" />
</section>
