---
import HeadlineBlock from '@/partials/headline/headline-block.tsx';
import RoadmapMobile from './roadmap-mobile.astro';
import RoadmapDesktop from './roadmap-desktop.astro';
import Circle from '@/assets/svgs/circle.astro';
import { roadmapHistory, roadmapStopVariants, type RoadmapStopVariant } from '@/mock/roadmap';
import { cn } from '@/utils/helpers';
---

<section
  id="roadmap"
  data-slot="roadmap-container"
  class="md: mx-auto flex max-w-125 flex-col items-center pt-30 md:max-w-250"
>
  <HeadlineBlock
    data-slot="roadmap-header"
    className="text-white"
    headlineVariant="h2"
    postHeadline="every opportunity on my way to where I am"
    subHeadline="journey"
  >
    Life Roadmap
  </HeadlineBlock>

  <ul class="flex flex-col gap-3 pt-6 pb-10 text-sm text-white/80 md:flex-row md:gap-8">
    {
      Object.entries(roadmapHistory).map(([variant, label]) => {
        const selectedVariant = roadmapStopVariants[variant as RoadmapStopVariant];

        return (
          <li class={cn(['flex items-center gap-3 rounded-xl border p-4', `border-${variant}`])}>
            <Circle class={cn(['size-6 shrink-0 fill-black', selectedVariant.circle])} />
            <span>
              <strong class="text-white capitalize">{variant}</strong> — {label}
            </span>
          </li>
        );
      })
    }
  </ul>
  <span class="text-text-gray pointer-events-none block pb-4 text-xl underline"
    >All the roadmap stops before Germany are from <span class="font-extrabold">Kyiv</span></span
  >

  <RoadmapMobile class="md:hidden" />
  <RoadmapDesktop class="hidden lg:flex" />
</section>
