---
import BaseLayout from '@/layouts/base-layout.astro';
import ContentWrapperLayout from '@/layouts/content-wrapper-layout.astro';

import Hero from '@/components/hero/hero.astro';
import About from '@/components/about/about.astro';
import Skills from '@/components/skills/skills.astro';
import CTA from '@/components/cta/cta.astro';
import Roadmap from '@/components/roadmap/roadmap.astro';
import { neon } from '@neondatabase/serverless';

const sql = neon(import.meta.env.DATABASE_URL);

const response = await sql`SELECT version()`;
const data = response[0].version;

import { languages } from '@/i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}
---

<BaseLayout>
  <Hero />
  <ContentWrapperLayout>
    <About />
    <Skills />
    <Roadmap />
    <CTA />
  </ContentWrapperLayout>
</BaseLayout>
